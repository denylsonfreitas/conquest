/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals"],
    // O Deno exige extensão explícita nos imports (`./x.ts`). Habilitar isto
    // só na config de teste deixa as funções da Edge Function rodarem no mesmo
    // vitest do app, sem afetar o build do Angular.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // As funções puras da Edge Function (Deno) são TypeScript agnóstico de
  // runtime, então rodam no mesmo vitest do app. `allowImportingTsExtensions`
  // aceita o `./x.ts` que o Deno exige nos imports.
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "supabase/functions/**/*.spec.ts"]
}
